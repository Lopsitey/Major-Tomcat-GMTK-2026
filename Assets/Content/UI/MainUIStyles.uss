VisualElement {
}

.countdown-label {
    align-self: center;
    align-content: flex-start;
    align-items: center;
    margin-top: 10px;
    color: white;
}

.arrow-box {
    align-self: flex-end;
    align-items: stretch;
    top: 45%;
    align-content: flex-start;
    justify-content: space-evenly;
    margin-right: 5px;
    min-height: auto;
    max-height: none;
    height: 30%;
}

.pause-button {
    align-self: flex-start;
    align-items: flex-start;
    top: auto;
    bottom: 8%;
    margin-top: 10px;
    margin-left: 10px;
}

.default-danger-overlay {
    flex-grow: 1;
}

.danger-flash-active {
    border-top-width: 50px;
    border-right-width: 50px;
    border-bottom-width: 50px;
    border-left-width: 50px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-color: rgba(255, 0, 0, 0.31);
    border-right-color: rgba(255, 0, 0, 0.31);
    border-top-color: rgba(255, 0, 0, 0.31);
    border-bottom-color: rgba(255, 0, 0, 0.31);
}

.patience-bars-container {
    position: absolute;
    left: 10px;
    top: 50%;
    width: 10%;
    flex-direction: column;
    align-items: stretch;
}

.patience-bar {
    margin-bottom: 8px;
    height: 20px;
    min-width: 280px;
}

.patience-bar-entry {
    flex-direction: column;
    margin-bottom: 8px;
    align-items: flex-start;
}

/* Dark pill behind the room label only — not the progress bar — so text stays
   readable over bright sky/clouds without covering the bar itself. */
.patience-bar-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #fdf6e3;
    margin-bottom: 4px;
    padding: 2px 2%;
    background-color: rgba(10, 14, 22, 0.75);
    border-radius: 4px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}
