<ui:UXML xmlns:ui="UnityEngine.UIElements"
         noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style
            src="project://database/Assets/Content/UI/Rooms/Living%20Quarters/Maintenance/WaterBowlUSS.uss?fileID=7433441132597879392&amp;guid=2ae0ce1d70269244e9563237e7ec9e51&amp;type=3#WaterBowlUSS"/>
    <!--
      Dense 5x5 pipe maze — every cell is a pipe (no empty blockers).
      Authored orientations form a winding S→E route with T/cross branches as red herrings.
      WaterBowl.BindUI scrambles corners / straights / T-junctions so it takes real work.
        Intended solution spine (among branches):
          S → across top → down right → left through mid → down → across bottom → E
    -->
    <ui:VisualElement class="grid-container">
        <!-- Row 0: S ── H ── T ── H ── C╮ -->
        <ui:VisualElement class="pipe-cell type-source"/>
        <ui:VisualElement class="pipe-cell type-straight-horizontal"/>
        <ui:VisualElement class="pipe-cell type-tjunction"/>
        <ui:VisualElement class="pipe-cell type-straight-horizontal"/>
        <ui:VisualElement class="pipe-cell type-corner"/>

        <!-- Row 1: C╮   X    V    C╯   V  -->
        <ui:VisualElement class="pipe-cell type-corner"/>
        <ui:VisualElement class="pipe-cell type-cross"/>
        <ui:VisualElement class="pipe-cell type-straight-vertical"/>
        <ui:VisualElement class="pipe-cell type-corner"/>
        <ui:VisualElement class="pipe-cell type-straight-vertical"/>

        <!-- Row 2: V    T    X ── H ── C╯ -->
        <ui:VisualElement class="pipe-cell type-straight-vertical"/>
        <ui:VisualElement class="pipe-cell type-tjunction"/>
        <ui:VisualElement class="pipe-cell type-cross"/>
        <ui:VisualElement class="pipe-cell type-straight-horizontal"/>
        <ui:VisualElement class="pipe-cell type-corner"/>

        <!-- Row 3: C╯ ── H ── T    X    V  -->
        <ui:VisualElement class="pipe-cell type-corner"/>
        <ui:VisualElement class="pipe-cell type-straight-horizontal"/>
        <ui:VisualElement class="pipe-cell type-tjunction"/>
        <ui:VisualElement class="pipe-cell type-cross"/>
        <ui:VisualElement class="pipe-cell type-straight-vertical"/>

        <!-- Row 4: C╮ ── H ── H ── H ── E -->
        <ui:VisualElement class="pipe-cell type-corner"/>
        <ui:VisualElement class="pipe-cell type-straight-horizontal"/>
        <ui:VisualElement class="pipe-cell type-straight-horizontal"/>
        <ui:VisualElement class="pipe-cell type-straight-horizontal"/>
        <ui:VisualElement class="pipe-cell type-end"/>
    </ui:VisualElement>
</ui:UXML>
