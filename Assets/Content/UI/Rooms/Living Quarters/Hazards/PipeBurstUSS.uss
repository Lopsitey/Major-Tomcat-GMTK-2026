.pipe-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(16, 38, 52, 0.93);
    padding: 24px;
}

.pipe-title {
    font-size: 28px;
    color: #ffffff;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.pipe-status {
    font-size: 16px;
    color: #9fd8ee;
    margin-bottom: 24px;
}

.gauge-track {
    width: 520px;
    height: 54px;
    background-color: #10222e;
    border-width: 4px;
    border-color: #2c5c74;
    border-radius: 8px;
    overflow: hidden;
}

.gauge-zone {
    position: absolute;
    top: 0;
    height: 100%;
    width: 26%;
    background-color: rgba(125, 255, 138, 0.35);
    border-left-width: 3px;
    border-right-width: 3px;
    border-left-color: #7dff8a;
    border-right-color: #7dff8a;
}

.gauge-needle {
    position: absolute;
    top: 0;
    left: 0;
    width: 8px;
    height: 100%;
    margin-left: -4px;
    background-color: #ff5a5a;
}

.release-button {
    width: 220px;
    height: 62px;
    margin-top: 30px;
    font-size: 22px;
    -unity-font-style: bold;
    color: #10222e;
    background-color: #7dd8ee;
    border-width: 4px;
    border-color: #2c5c74;
    border-radius: 10px;
    cursor: hand;
}

.release-button:hover {
    background-color: #a4e6f7;
}

.release-button:active {
    scale: 0.95;
}

.pipe-hint {
    font-size: 14px;
    color: #6e9cb0;
    margin-top: 22px;
}
