.oil-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(22, 22, 26, 0.94);
    padding: 20px;
}

.oil-title {
    font-size: 28px;
    color: #ffffff;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.oil-status {
    font-size: 16px;
    color: #c8b89a;
    margin-bottom: 16px;
}

.oil-field {
    width: 560px;
    height: 320px;
    background-color: rgba(52, 52, 58, 0.9);
    border-width: 3px;
    border-color: #16161a;
    border-radius: 10px;
}

.oil-slick {
    position: absolute;
    width: 104px;
    height: 74px;
    background-color: #1d1a14;
    border-radius: 999px;
    border-width: 3px;
    border-color: #4a3f28;
    cursor: hand;
}

.oil-slick:hover {
    border-color: #d8b45a;
}

.oil-hint {
    font-size: 14px;
    color: #8a8070;
    margin-top: 16px;
}
