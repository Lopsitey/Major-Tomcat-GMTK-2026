.seesaw-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(20, 28, 48, 0.92);
    padding: 24px;
}

.seesaw-title {
    font-size: 28px;
    color: #ffffff;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.seesaw-status {
    font-size: 16px;
    color: #b8c4d8;
    margin-bottom: 18px;
}

.seesaw-stage {
    width: 460px;
    height: 220px;
    align-items: center;
    justify-content: center;
}

.seesaw-beam {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 400px;
    height: 26px;
    background-color: #7c8aa5;
    border-radius: 6px;
    border-width: 3px;
    border-color: #414c63;
}

.seesaw-pad {
    width: 90px;
    height: 62px;
    background-color: #d4a017;
    border-width: 3px;
    border-color: #8a6a10;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    cursor: hand;
}

.seesaw-pad:hover {
    background-color: #e8b62c;
}

.seesaw-pad:active {
    scale: 0.94;
}

.seesaw-pivot {
    position: absolute;
    width: 0;
    height: 0;
    border-left-width: 26px;
    border-right-width: 26px;
    border-top-width: 0;
    border-bottom-width: 46px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-bottom-color: #5a6478;
    top: 130px;
}

.balance-track {
    width: 320px;
    height: 18px;
    margin-top: 22px;
    background-color: #2a3350;
    border-radius: 9px;
    border-width: 2px;
    border-color: #4a5878;
    overflow: hidden;
}

.balance-fill {
    width: 0;
    height: 100%;
    background-color: #7dff8a;
}

.seesaw-hint {
    font-size: 14px;
    color: #8f9cb5;
    margin-top: 14px;
}
