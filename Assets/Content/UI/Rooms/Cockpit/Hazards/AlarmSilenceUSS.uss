.alarm-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(38, 14, 18, 0.93);
    padding: 24px;
}

.alarm-title {
    font-size: 28px;
    color: #ffffff;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.alarm-status {
    font-size: 16px;
    color: #f0b8b8;
    margin-bottom: 24px;
}

.alarm-grid {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.alarm-lamp {
    width: 86px;
    height: 86px;
    margin: 12px;
    border-radius: 999px;
    background-color: #4a2026;
    border-width: 5px;
    border-color: #2a1216;
    cursor: hand;
    transition: all 0.12s ease;
}

.alarm-lamp:hover {
    scale: 1.05;
}

.alarm-lit {
    background-color: #ff3b30;
    border-color: #ffd0cc;
    scale: 1.12;
}

.alarm-off {
    background-color: #2f4a35;
    border-color: #1c2c20;
    opacity: 0.55;
}

.alarm-hint {
    font-size: 14px;
    color: #c79a9a;
    margin-top: 24px;
}
