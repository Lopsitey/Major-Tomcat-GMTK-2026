.jigsaw-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(48, 26, 18, 0.92);
    padding: 24px;
}

.jigsaw-title {
    font-size: 28px;
    color: #ffffff;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.jigsaw-status {
    font-size: 16px;
    color: #e6c9ac;
    margin-bottom: 20px;
}

.jigsaw-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.jigsaw-shard {
    width: 92px;
    height: 110px;
    margin: 8px;
    border-width: 4px;
    border-color: #3a2418;
    border-radius: 10px;
    font-size: 40px;
    color: #3a2418;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    cursor: hand;
    transition: all 0.15s ease;
}

.jigsaw-shard:hover {
    scale: 1.05;
}

.jigsaw-selected {
    border-color: #ffffff;
    scale: 1.1;
}

.jigsaw-hint {
    font-size: 14px;
    color: #b79a80;
    margin-top: 20px;
}
