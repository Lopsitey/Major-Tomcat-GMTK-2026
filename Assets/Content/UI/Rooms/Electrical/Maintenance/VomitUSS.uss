.vomit-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(40, 30, 60, 0.9);
    padding: 20px;
}

.vomit-title {
    font-size: 28px;
    color: #ffffff;
    margin-bottom: 30px;
    -unity-font-style: bold;
}

.vomit-area {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    width: 90%;
    gap: 20px;
}

.vomit-spot {
    width: 80px;
    height: 80px;
    background-color: #8B6914;
    border-radius: 50%;
    cursor: hand;
    transition: all 0.2s ease;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
}

.vomit-spot:hover {
    background-color: #A0821A;
    scale: 1.1;
}

.vomit-spot:active {
    scale: 0.9;
}
