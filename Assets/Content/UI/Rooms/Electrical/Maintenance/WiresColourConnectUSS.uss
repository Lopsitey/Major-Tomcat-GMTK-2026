.wire-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(24, 26, 34, 0.93);
    padding: 24px;
}

.wire-title {
    font-size: 28px;
    color: #ffffff;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.wire-status {
    font-size: 16px;
    color: #b9c4d4;
    margin-bottom: 22px;
}

.wire-board {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 480px;
    padding: 18px;
    background-color: rgba(46, 50, 62, 0.9);
    border-width: 3px;
    border-color: #14161c;
    border-radius: 10px;
}

.wire-column {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.wire-port {
    width: 74px;
    height: 46px;
    margin: 9px;
    border-width: 4px;
    border-color: #14161c;
    border-radius: 8px;
    cursor: hand;
    transition: all 0.12s ease;
}

.wire-port:hover {
    scale: 1.06;
}

.wire-selected {
    border-color: #ffffff;
    scale: 1.1;
}

.wire-connected {
    border-color: #7dff8a;
    opacity: 0.5;
}

.wire-gap {
    width: 120px;
    height: 4px;
    background-color: #14161c;
}

.wire-hint {
    font-size: 14px;
    color: #7f8a9c;
    margin-top: 22px;
}
