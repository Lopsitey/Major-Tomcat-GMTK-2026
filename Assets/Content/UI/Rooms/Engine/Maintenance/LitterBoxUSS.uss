.litter-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(40, 30, 60, 0.9);
    padding: 20px;
}

.litter-title {
    font-size: 28px;
    color: #ffffff;
    margin-bottom: 20px;
    -unity-font-style: bold;
}

.trays-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 90%;
    gap: 16px;
    margin-bottom: 20px;
}

.litter-tray {
    width: 100px;
    height: 100px;
    background-color: #8B4513;
    border-width: 3px;
    border-color: #654321;
    border-radius: 8px;
    cursor: hand;
    transition: all 0.2s ease;
}

.litter-tray:hover {
    background-color: #A0522D;
    scale: 1.05;
}

.litter-tray:active {
    scale: 0.95;
}

.litter-poo {
    position: absolute;
    width: 60px;
    height: 60px;
    background-image: url('project://database/Assets/Content/UI/Rooms/Cockpit/Maintenance/poo-emoji.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    cursor: hand;
    opacity: 0;
}

.litter-poo:hover {
    scale: 1.1;
}
